FoamFile { format ascii; class dictionary; location "system"; object functions; }

telT
{
    type            volFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          tel;
    writeControl    timeStep;
    writeInterval   10;
    writeFields     no;
    cellZone        all;
    operation       max;
    fields          (T);
}
telTort
{
    $telT;
    operation       volAverage;
}
gazMax
{
    type            volFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          fluid;
    writeControl    timeStep;
    writeInterval   10;
    writeFields     no;
    cellZone        all;
    operation       max;
    fields          (T CO2 CH4);
}
sibalKutle
{
    type            volFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          sibal;
    writeControl    timeStep;
    writeInterval   1;
    writeFields     no;
    cellZone        all;
    operation       volIntegrate;
    fields          (rhoV rhoCh);
}
sibalMaxT
{
    type            volFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          sibal;
    writeControl    timeStep;
    writeInterval   10;
    writeFields     no;
    cellZone        all;
    operation       max;
    fields          (T);
}
yakitAkisi
{
    type            surfaceFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          fluid;
    writeControl    timeStep;
    writeInterval   1;
    writeFields     no;
    select          patch;
    patch           fluid_to_sibal;
    operation       sum;
    fields          (phi);
}
gazProb
{
    type            probes;
    libs            ("libsampling.so");
    region          fluid;
    writeControl    timeStep;
    writeInterval   10;
    fields          (T CH4 O2 CO2);
    probeLocations
    (
        (0.15625 0.00032 0)   // telin 0.05 mm ustu
        (0.15625 0.001 0)     // tel ekseni, y = 1 mm
        (0.158 0.0002 0)      // telin 1.75 mm asagi akisi, yuzeye yakin
        (0.20 0.001 0)
        (0.30 0.001 0)
        (0.49 0.010 0)        // TC (34 cm / 10 mm), deney t=10 s'de 429 K
        (0.77 0.008 0)
    );
}
sibalYuzey
{
    type            surfaces;
    libs            ("libsampling.so");
    region          sibal;
    writeControl    adjustableRunTime;
    writeInterval   0.05;
    surfaceFormat   raw;
    interpolate     false;
    interpolationScheme cell;
    fields          (T rhoV rhoCh);
    surfaces
    {
        ust { type patch; patches (sibal_to_fluid); }
    }
}

gIntegral
{
    type            volFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          fluid;
    writeControl    timeStep;
    writeInterval   10;
    writeFields     no;
    cellZone        all;
    operation       volIntegrate;
    fields          (G);
}
gMax
{
    $gIntegral;
    operation       max;
}
// --- Saffire-III deney sensorleri (konumlar: x = ornek on kenari 0.15 m + deney mesafesi) ---
// TC7-TC12 = A-F eslemesi (Saffire-I semasindan CIKARIM): A 30cm yuzey, B 32cm 3mm, C 34cm 10mm, D 60cm yuzey, E 62cm 8mm, F 64cm 15mm
sensGaz
{
    type            probes;
    libs            ("libsampling.so");
    region          fluid;
    writeControl    adjustableRunTime;
    writeInterval   0.02;
    fields          (T);
    probeLocations
    (
        (0.47 0.003 0)    // B  (TC8)  32 cm, 3 mm
        (0.49 0.010 0)    // C  (TC9)  34 cm, 10 mm
        (0.77 0.008 0)    // E  (TC11) 62 cm, 8 mm
        (0.79 0.015 0)    // F  (TC12) 64 cm, 15 mm
    );
}
// 10.11: TC boncuklari elle dikili (NTRS 20170002628) -> yukseklik belirsizligi icin ek noktalar (2. tur analizi)
sensGazYukseklik
{
    $sensGaz;
    probeLocations
    (
        (0.47 0.001 0) (0.47 0.002 0) (0.47 0.004 0) (0.47 0.005 0)   // TC8 cevresi
        (0.49 0.008 0) (0.49 0.012 0)                                 // TC9 cevresi
        (0.77 0.006 0) (0.77 0.010 0)                                 // TC11 cevresi
        (0.79 0.013 0) (0.79 0.017 0)                                 // TC12 cevresi
    );
}
sensYuzey
{
    $sensGaz;
    region          sibal;
    probeLocations
    (
        (0.45 -0.00003 0)  // A (TC7)  30 cm yuzey
        (0.75 -0.00003 0)  // D (TC10) 60 cm yuzey
    );
}
sensRadMenba
{
    $sensGaz;
    fields          (G);
    probeLocations
    (
        (0.20 0.29 0) (0.30 0.29 0) (0.40 0.29 0) (0.50 0.29 0) (0.60 0.29 0)   // menba yarisi (R1,R3)
    );
}
sensRadAkis
{
    $sensRadMenba;
    probeLocations
    (
        (0.70 0.29 0) (0.80 0.29 0) (0.90 0.29 0) (1.00 0.29 0) (1.05 0.29 0)   // akis asagisi yarisi (R2,R4)
    );
}
