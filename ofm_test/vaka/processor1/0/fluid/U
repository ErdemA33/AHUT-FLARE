FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0/fluid";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0.2453 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0.2453 0 0);
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        tangentialVelocity nonuniform List<vector> 0();
        value           nonuniform List<vector> 0();
    }
    top
    {
        type            slip;
    }
    base
    {
        type            slip;
    }
    frontAndBack
    {
        type            empty;
    }
    fluid_to_tel
    {
        type            noSlip;
    }
    fluid_to_sibal
    {
        type            coupledPyrolysisVelocity;
        value           uniform (0 0 0);
    }
    procBoundary1to0
    {
        type            processor;
        value           uniform (0.2453 0 0);
    }
}


