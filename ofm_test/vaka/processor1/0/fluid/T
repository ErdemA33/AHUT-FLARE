FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 294.32;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 294.32;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      nonuniform List<scalar> 0();
        value           nonuniform List<scalar> 0();
    }
    top
    {
        type            zeroGradient;
    }
    base
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
    fluid_to_tel
    {
        type            coupledTemperature;
        qr              qr;
        value           uniform 294.32;
    }
    fluid_to_sibal
    {
        type            coupledTemperature;
        qr              qr;
        value           uniform 294.32;
    }
    procBoundary1to0
    {
        type            processor;
        value           uniform 294.32;
    }
}


