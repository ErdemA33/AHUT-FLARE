FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      H2O;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField   uniform 0.0072;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.0072;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      nonuniform List<scalar> 0();
        value           nonuniform List<scalar> 0();
    }
    top
    {
        type            zeroGradient;
    }
    base
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
    fluid_to_tel
    {
        type            zeroGradient;
    }
    fluid_to_sibal
    {
        type            coupledPyrolysisSpecies;
        refValue        uniform 0.0072;
        refGradient     uniform 0;
        valueFraction   uniform 0;
        value           uniform 0.0072;
        fuel            false;
    }
    procBoundary1to0
    {
        type            processor;
        value           uniform 0.0072;
    }
}


