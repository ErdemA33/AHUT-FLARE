FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      G;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            MarshakRadiation;
        emissivityMode  lookup;
        emissivity      uniform 1;
        value           nonuniform List<scalar> 0();
    }
    outlet
    {
        type            MarshakRadiation;
        emissivityMode  lookup;
        emissivity      uniform 1;
        value           uniform 0;
    }
    top
    {
        type            MarshakRadiation;
        emissivityMode  lookup;
        emissivity      uniform 1;
        value           uniform 0;
    }
    base
    {
        type            MarshakRadiation;
        emissivityMode  lookup;
        emissivity      uniform 1;
        value           uniform 0;
    }
    frontAndBack
    {
        type            empty;
    }
    fluid_to_tel
    {
        type            MarshakRadiation;
        emissivityMode  lookup;
        emissivity      uniform 0.7;
        value           nonuniform List<scalar> 0();
    }
    fluid_to_sibal
    {
        type            MarshakRadiation;
        emissivityMode  lookup;
        emissivity      uniform 0.8;
        value           uniform 0;
    }
    procBoundary3to2
    {
        type            processor;
        value           uniform 0;
    }
}


